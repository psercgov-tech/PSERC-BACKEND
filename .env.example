PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/pserc
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=https://pserc.vercel.app

JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=4h

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pserc

ADMIN_EMAIL=admin@pserc.ng
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=PSERC Admin

ENABLE_SWAGGER=false
