PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/pserc
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS (Vercel + official domain when live)
FRONTEND_ORIGINS=https://pserc.vercel.app,https://pserc.pl.gov.ng,https://www.pserc.pl.gov.ng

JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=4h

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pserc

ADMIN_EMAIL=admin@pserc.ng
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=PSERC Admin

ENABLE_SWAGGER=false

# Email — Gmail OAuth2 (same pattern as Trackpro). Required for portal forgot-password.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
# GMAIL_REFRESH_TOKEN=
# GMAIL_USER=youraccount@gmail.com
# GMAIL_FROM=PSERC Portal <youraccount@gmail.com>
# EMAIL_LOGO_URL=https://pserc.vercel.app/images/logo-seal.png
# EMAIL_VERIFY_ON_BOOT=false
